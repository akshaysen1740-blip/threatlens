{
  "name": "threatlens-gateway",
  "version": "1.0.0",
  "description": "ThreatLens API gateway: auth, scan API, Redis Streams producer/consumer and real-time updates",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "watch:scans": "node scripts/watch-scans.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "socket.io": "4.8.1",
    "swagger-ui-express": "5.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.7",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.7",
    "jest": "29.7.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
