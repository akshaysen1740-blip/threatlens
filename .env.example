# Copy this file to .env and adjust. Everything is optional: the project runs with the defaults.
#   cp .env.example .env

# ---------- AI explanations (optional) ----------
# Provider: none | openai | anthropic | gemini
# With "none" (or no key) the worker uses rule-based explanations.
LLM_PROVIDER=none
LLM_API_KEY=
# Leave empty to use the provider default (see worker/app/ai/explainer.py)
LLM_MODEL=

# ---------- Security (change these for any real deployment) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=*

# ---------- Scanning ----------
MAX_ATTEMPTS=3
SCAN_TIMEOUT_SECONDS=45
SCAN_TIMEOUT_MS=120000
# Set to false to skip DNS and SSL lookups (faster, works offline)
ENABLE_NETWORK_CHECKS=true

# ---------- Misc ----------
GATEWAY_PORT=4000
LOG_LEVEL=info
